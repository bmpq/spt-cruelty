<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Version>0.0.1</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);SPT_4_0</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\cruelty.shared.ui\tarkin.cruelty.shared.ui.csproj" />
    <ProjectReference Include="..\cruelty.shared\tarkin.cruelty.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\core\0Harmony.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\core\BepInEx.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll">
      <Private>False</Private>
    </Reference>
    
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\AnimationSystem.Types.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyFilesAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <ScriptsDir>$(SPTPath)\BepInEx\scripts\tarkin-cruelty\</ScriptsDir>
      <PluginsDir>$(SPTPath)\BepInEx\plugins\tarkin-cruelty\</PluginsDir>
      
      <BepDestination Condition="'$(Configuration)' == 'Debug'">$(ScriptsDir)</BepDestination>
      <BepDestination Condition="'$(Configuration)' == 'Release'">$(PluginsDir)</BepDestination>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <ObsoleteFiles Include="$(PluginsDir)$(AssemblyName).dll" />
      <ObsoleteFiles Include="$(PluginsDir)$(AssemblyName).pdb" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <ObsoleteFiles Include="$(ScriptsDir)$(AssemblyName).dll" />
      <ObsoleteFiles Include="$(ScriptsDir)$(AssemblyName).pdb" />
    </ItemGroup>

    <Delete Files="@(ObsoleteFiles)" />

    <ItemGroup>
      <CoreFiles Include="$(OutputPath)\tarkin.cruelty.shared.ui.dll" />
      <BepFiles Include="$(OutputPath)\$(AssemblyName).dll" />
      <BepFiles Include="$(OutputPath)\$(AssemblyName).pdb" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ScriptsDir)" Condition="'@(FilesToCopy)' != ''" />
    <Copy SourceFiles="@(CoreFiles)" DestinationFolder="$(PluginsDir)" />
    <Copy SourceFiles="@(BepFiles)" DestinationFolder="$(BepDestination)" />
  </Target>

  <!-- release zipping -->
  <Target Name="PackageZip" AfterTargets="CopyFilesAfterBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ZipStagingDir>$(IntermediateOutputPath)ZipStaging\</ZipStagingDir>
      <ZipPluginDir>$(ZipStagingDir)BepInEx\plugins\tarkin-cruelty\</ZipPluginDir>
      <ZipFileName>tarkin-cruelty-v$(Version).zip</ZipFileName>
      <ZipOutputPath>$(OutputPath)$(ZipFileName)</ZipOutputPath>
    </PropertyGroup>

    <RemoveDir Directories="$(ZipStagingDir)" />

    <!-- grabs everything from BepDestination folder, except folders starting with a dot prefix -->
    <ItemGroup>
      <FilesToZip Include="$(BepDestination)**\*.*" Exclude="$(BepDestination)**\.*\**\*.*;$(BepDestination)tarkin.cruelty.fika.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToZip)" DestinationFolder="$(ZipPluginDir)%(RecursiveDir)" />

    <ZipDirectory SourceDirectory="$(ZipStagingDir)" DestinationFile="$(ZipOutputPath)" Overwrite="true" />

    <RemoveDir Directories="$(ZipStagingDir)" />
    <Message Importance="High" Text="Successfully packaged release: $(ZipOutputPath)" />
  </Target>
</Project>
