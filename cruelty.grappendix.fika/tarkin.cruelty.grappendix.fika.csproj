<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Version>0.0.1</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);SPT_4_1</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\core\0Harmony.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\core\BepInEx.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll">
      <Private>False</Private>
    </Reference>
    
    <Reference Include=".References\Fika.Core.2.4.3.0.dll">
      <Private>False</Private>
    </Reference>
    
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\AnimationSystem.Types.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyFilesAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <PluginsDir>$(SPTPath)\BepInEx\plugins\tarkin-grappendix\</PluginsDir>
      <BepDestination>$(PluginsDir)</BepDestination>
    </PropertyGroup>

    <ItemGroup>
      <BepFiles Include="$(OutputPath)\$(AssemblyName).dll" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ScriptsDir)" Condition="'@(FilesToCopy)' != ''" />
    <Copy SourceFiles="@(CoreFiles)" DestinationFolder="$(PluginsDir)" />
    <Copy SourceFiles="@(BepFiles)" DestinationFolder="$(BepDestination)" />
  </Target>

</Project>
